EXPO_PUBLIC_API_URL=http://localhost:2000
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Public address of the ShareSync web app, used in share links (e.g. https://sharesync.example.com)
EXPO_PUBLIC_WEB_URL=

# Google Sign-In
# Web works with the Firebase project's Google provider (Firebase Console → Authentication → Sign-in method → Google).
# Android/iOS additionally need OAuth client IDs from Google Cloud Console (APIs & Services → Credentials)
# and a development build (npx expo run:android / run:ios, or EAS). The web client ID is the one Firebase created.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

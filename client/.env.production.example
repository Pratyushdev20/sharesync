# Production values for the ShareSync app (web export and EAS builds).
# Copy to .env.production (git-ignored) or set them as EAS environment variables.

# Your deployed API (Render web service or custom domain), https only
EXPO_PUBLIC_API_URL=https://api.yourdomain.com
# Where the web app is hosted (used in share links)
EXPO_PUBLIC_WEB_URL=https://app.yourdomain.com

# Firebase web config (same project as the server's service account)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google Sign-In (see client/scripts/check-google-signin.mjs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

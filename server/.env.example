PORT=2000
NODE_ENV=development

# PostgreSQL
DB_USER=
DB_HOST=localhost
DB_NAME=
DB_PASSWORD=
DB_PORT=5432

# Firebase Admin (service account)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Encryption at rest for uploaded files (32 random bytes, base64).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BACK IT UP - if it is lost, stored files cannot be decrypted.
FILE_ENCRYPTION_KEY=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional tuning
# MAX_FILE_SIZE=52428800
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20

# Structured logging: debug | info | warn | error
# LOG_LEVEL=info

# Object storage: "local" (disk, default) or "s3" (AWS S3, Cloudflare R2, MinIO, Backblaze B2 ...)
STORAGE_DRIVER=local
# UPLOAD_DIR=./uploads
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=            # e.g. https://<account>.r2.cloudflarestorage.com or http://localhost:9000
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   # true for MinIO
# S3_PREFIX=sharesync/
# S3_SSE=true                 # request provider-side encryption too (files are already encrypted by the app)

# Database TLS (managed PostgreSQL)
# DB_SSL=true
# DB_POOL_MAX=10

# Real-time sync change-feed retention in days
# SYNC_RETENTION_DAYS=30

# Mobile push notifications through the Expo push service (optional)
# PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=
